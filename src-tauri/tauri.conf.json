{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PromptForge",
  "version": "0.2.1",
  "identifier": "com.promptforge.desktop",
  "build": {
    "frontendDist": "../dist-app",
    "devUrl": null,
    "beforeDevCommand": "npm run sync:dist",
    "beforeBuildCommand": "npm run sync:dist"
  },
  "app": {
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "startMenuFolder": "PromptForge"
      }
    }
  }
}
